# URL da API. Em desenvolvimento os tres frontends falam com a mesma API.
VITE_API_BASE_URL=http://localhost:3000

# Endereco PUBLICO da vitrine desta instalacao.
#
# O painel usa esta base para abrir um sorteio na vitrine ("Ver na vitrine").
# Painel e vitrine vivem em dominios diferentes: sem esta variavel o link
# apontaria para o dominio do PAINEL, onde a rota nao existe.
#
# Sem valor configurado o botao simplesmente nao aparece. NAO ha queda para
# localhost: um link que funciona so na maquina de quem desenvolve e pior
# que nenhum link.
#
# O valor real de cada ambiente vai no painel do provedor, nunca aqui.
VITE_STOREFRONT_BASE_URL=https://storefront.example.com
