# =============================================================================
# Frontend — variaveis de DESENVOLVIMENTO
#
# Tudo aqui e PUBLICO. O Vite substitui cada `VITE_*` por seu valor literal no
# pacote JavaScript entregue ao navegador: quem abre o site le o conteudo. Nao
# existe segredo "so no frontend" — se precisa ficar escondido, pertence a API.
#
# Os valores de cada ambiente vao no painel do Vercel, por projeto e por
# Production/Preview/Development, nunca neste arquivo.
#
# Cada aplicacao tambem tem seu proprio `.env.example` em apps/<app>/, que e o
# que o Vite le durante `npm run dev`. Este arquivo e o panorama.
# =============================================================================

# Endereco da API. Os tres frontends falam com a mesma API.
# Em producao/staging e o host do servico no Render — jamais um localhost.
VITE_API_BASE_URL=http://localhost:3000

# Endereco PUBLICO da vitrine. Usado SO pelo painel do organizador, para abrir
# um sorteio na vitrine ("Ver na vitrine"). Painel e vitrine vivem em dominios
# diferentes, entao o link precisa ser absoluto. Sem valor, o botao nao
# aparece: um link que so funciona na maquina de quem desenvolve e pior que
# link nenhum.
VITE_STOREFRONT_BASE_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# O que NAO mora aqui
#
# DATABASE_URL, MFA_ENCRYPTION_KEY, credenciais de fila e qualquer papel de
# banco ficam no repositorio tironirifa-backend e nos paineis dos servicos. O
# frontend nunca recebeu credencial de banco, e a separacao nao e ocasiao para
# comecar.
# -----------------------------------------------------------------------------
