{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "types": ["node", "@testing-library/jest-dom"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "vitest.setup.ts",
    "packages/shared/tests/**/*.ts",
    "apps/*/tests/**/*.{ts,tsx}"
  ]
}
